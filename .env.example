# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERPAPI_KEY: Required for live Google Maps / Local business search across US states/cities.
# Get a free key with 100 searches/month at https://serpapi.com/
SERPAPI_KEY="MY_SERPAPI_KEY"

# FIRECRAWL_API_KEY: Required for scraping business websites to extract public business contact emails.
# Get a free key with 500 credits at https://www.firecrawl.dev/
FIRECRAWL_API_KEY="MY_FIRECRAWL_API_KEY"

# RESEND_API_KEY: Required for transactional/campaign business emails.
# Get a free key with 3,000 emails/month at https://resend.com/
RESEND_API_KEY="MY_RESEND_API_KEY"

# EMAIL_FROM: Verified sender email or Resend default sandbox sender.
EMAIL_FROM="HomeDecor Outreach <onboarding@resend.dev>"

